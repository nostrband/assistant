# OpenRouter API Key (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Custom OpenRouter base URL (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://your-custom-openrouter-proxy.com/api/v1

# Optional: Agent model (defaults to openai/gpt-oss-120b)
# AGENT_MODEL=openai/gpt-4o-mini

# Optional: Custom data directory path (defaults to current directory)
# DATA_PATH=/path/to/your/data/directory

# Optional: Password protection (if not set, no auth required)
# USER_PASSWORD=your_password_here
