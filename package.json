{
  "name": "assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:jobs",
    "build:jobs": "esbuild scripts/job-runner.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/job-runner.js --external:dotenv --external:@libsql/client --external:@neon-rs/load --external:libsql",
    "start:web": "next start",
    "start:bg": "node dist/job-runner.js",
    "start": "concurrently -k -n WEB,JOBS -c cyan,magenta \"npm:start:web\" \"npm:start:bg\"",
    "lint": "eslint"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.42",
    "@ai-sdk/provider": "^2.0.0",
    "@ai-sdk/provider-utils": "^3.0.9",
    "@ai-sdk/provider-utils-v5": "npm:@ai-sdk/provider-utils@^3.0.9",
    "@ai-sdk/provider-v5": "npm:@ai-sdk/provider@^2.0.0",
    "@ai-sdk/react": "^2.0.60",
    "@libsql/client": "^0.15.15",
    "@mastra/ai-sdk": "^0.1.0",
    "@mastra/core": "^0.20.0",
    "@mastra/libsql": "^0.15.0",
    "@mastra/memory": "^0.15.4",
    "@openrouter/ai-sdk-provider": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "ai": "^5.0.60",
    "ai-elements": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9",
    "dotenv": "^16.4.5",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.544.0",
    "nanoid": "^5.1.6",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "streamdown": "^1.3.0",
    "tailwind-merge": "^3.3.1",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "esbuild": "^0.24.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "node-loader": "^2.1.0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  }
}
